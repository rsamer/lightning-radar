# Lightning Radar — environment configuration
# Copy to .env and adjust values as needed.
# Note: the backend reads config from app/core/config.py, not from this file directly.
# These values document the available settings.

# Backend server
WS_HOST=127.0.0.1
WS_PORT=8000

# Blitzortung WebSocket endpoint
BLITZ_WS=wss://ws1.blitzortung.org

# Target location — set this to your city
TARGET_NAME=Vienna
TARGET_LAT=48.21
TARGET_LON=16.37

# Observation and alert radii in km
OBS_RADIUS_KM=500.0
ALERT_RADIUS_KM=50.0

# SQLite database path (relative to backend/)
DB_PATH=data/lightning.db
